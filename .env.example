# Resend SMTP. Copy this file to .env.local and fill in the values below.
# Keep these variables server-only (no NEXT_PUBLIC_ prefix).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Your Resend API key is also the SMTP password.
SMTP_PASSWORD=

# Use a sender address on a domain you have verified in Resend.
QUOTE_FROM_EMAIL=
# The inbox that should receive quote requests.
QUOTE_TO_EMAIL=
